#!/usr/bin/python3
"""Backend for the Wacom Bamboo bar widget.

Settings live in ~/.config/omarchy/tablet.json and reach Hyprland through
`hyprctl eval`, so the Hyprland config is never edited. Eval'd settings last
until Hyprland reloads its config; tablet-buttons, which the panel keeps
running, runs `tablet-ctl apply` again after every reload.

  tablet-ctl status                 -> JSON: settings, tablet, monitors, area
  tablet-ctl set '<json patch>'     -> merge patch, write, reload, print status
  tablet-ctl reset                  -> restore defaults
  tablet-ctl toggle <key>           -> flip an on/off setting, e.g. fingerEnabled
                                       (handy as a button command)
  tablet-ctl apply                  -> send the settings to Hyprland again
  tablet-ctl enable-access          -> ask (pkexec) to install a udev rule giving the
                                       logged-in user the tablet and /dev/uinput
  tablet-ctl unlatch                -> (internal) clear libinput's pen/touch rotation
                                       latch once the pen is out of proximity
"""
import time
import fcntl
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import tabletarea  # noqa: E402
import tabletlib  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/omarchy/tablet.json")
# 0.1-0.3 wrote the settings to tablet.lua and required it from hyprland.lua.
LEGACY_LUA = os.path.join(HOME, ".config/hypr/tablet.lua")
HYPRLAND = os.path.join(HOME, ".config/hypr/hyprland.lua")
LEGACY_REQUIRE = 'require("hypr.tablet")'
# Held by the running tablet-buttons (the panel starts it).
DAEMON_LOCK = os.path.join(HOME, ".cache/omarchy-tablet/tablet-buttons.lock")

FALLBACK_MM = [147.2, 92.0]

DEFAULTS = {
    "output": "",             # monitor name, "" = every monitor
    "rotation": 0,            # 0 / 90 / 180 (flipped, left-handed) / 270
    "areaPercent": 100,       # share of the surface used, centred
    "matchAspect": True,      # crop the area to the monitor's aspect ratio
    "pressure": 0,            # 0..100, higher = lighter touch reaches full
    "fingerEnabled": True,
    "fingerSpeed": 0.0,       # -1..1
    "naturalScroll": True,
    "tapToClick": True,
    "areaLock": False,        # lock the pen to the window of the apps below
    "areaActivate": "button",  # "button": the arealock key locks the focused window; "hover": focus on a listed app does; "tap": a tap on one does
    "ignoreTaps": False,      # the pen tip does not click in the apps below (no stray drags)
    "tapIgnoredApps": list(tabletarea.TAP_IGNORED_DEFAULT),  # window classes; starts as the file managers
    "apps": {},               # window class -> {"mode": "window"}
    "ignoredApps": [],        # window classes the panel's app scan should not suggest
    "buttons": {},            # "pen1".."pen3" and pad key codes ("BTN_RIGHT") -> {action, value}
    "slotCodes": {},          # "vendor:product" -> {layout letter: code}, from Identify keys
    "lastDevice": {},         # names and size of the last tablet seen, for writing while unplugged
}
ACTIONS = tabletlib.ACTIONS
# 0.1 keyed the CTH-460's keys pad1..pad4 by the code the kernel sends.
LEGACY_PAD = {"pad1": "BTN_LEFT", "pad2": "BTN_FORWARD", "pad3": "BTN_BACK", "pad4": "BTN_RIGHT"}


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout or "null")
    except Exception:
        return None


def migrate(data):
    buttons = data.get("buttons") or {}
    if any(k in buttons for k in LEGACY_PAD):
        data["buttons"] = {LEGACY_PAD.get(k, k): v for k, v in buttons.items()}
    data.pop("padOrder", None)
    data.pop("leftHanded", None)
    return data


def load():
    data = dict(DEFAULTS)
    try:
        with open(STATE) as f:
            saved = migrate(json.load(f))
        data.update({k: v for k, v in saved.items() if k in DEFAULTS})
    except (OSError, ValueError, AttributeError):
        pass
    return sanitize(data)


def sanitize(s):
    out = dict(DEFAULTS)
    out["output"] = str(s.get("output", ""))
    out["rotation"] = int(s.get("rotation", 0)) % 360 // 90 * 90
    out["areaPercent"] = max(30, min(100, int(round(float(s.get("areaPercent", 100))))))
    out["matchAspect"] = bool(s.get("matchAspect"))
    out["pressure"] = max(0, min(100, int(round(float(s.get("pressure", 0))))))
    out["fingerEnabled"] = bool(s.get("fingerEnabled"))
    out["fingerSpeed"] = round(max(-1.0, min(1.0, float(s.get("fingerSpeed", 0)))), 2)
    out["naturalScroll"] = bool(s.get("naturalScroll"))
    out["tapToClick"] = bool(s.get("tapToClick"))
    out["areaLock"] = bool(s.get("areaLock"))
    out["ignoreTaps"] = bool(s.get("ignoreTaps"))
    out["tapIgnoredApps"] = [str(c)[:200] for c in s.get("tapIgnoredApps", []) if isinstance(c, str)][:100]
    out["areaActivate"] = s["areaActivate"] if s.get("areaActivate") in ("hover", "tap") else "button"
    out["apps"] = {str(k)[:200]: {"mode": "window"} for k, v in (s.get("apps") or {}).items() if isinstance(v, dict)}
    out["ignoredApps"] = [str(c)[:200] for c in (s.get("ignoredApps") or []) if isinstance(c, str)][:500]
    buttons = {}
    for key, spec in (s.get("buttons") or {}).items():
        if not isinstance(spec, dict):
            continue
        action = spec.get("action", "none")
        if action not in ACTIONS:
            action = "none"
        buttons[str(key)] = {"action": action, "value": str(spec.get("value", ""))[:200]}
    out["buttons"] = buttons
    out["slotCodes"] = {str(k): {str(l): str(c) for l, c in v.items()}
                        for k, v in (s.get("slotCodes") or {}).items() if isinstance(v, dict)}
    out["lastDevice"] = dict(s.get("lastDevice") or {})
    return out


def current_tablet(s):
    """(detected tablet, its description at the current rotation) or (None, None)."""
    tablet = tabletlib.detect()
    if not tablet:
        return None, None
    key = f'{tablet["vendor"]}:{tablet["product"]}'
    return tablet, tabletlib.describe(tablet, s["rotation"], s["slotCodes"].get(key))


def monitors():
    result = []
    for m in hypr_json("monitors") or []:
        w = m["width"] / m["scale"]
        h = m["height"] / m["scale"]
        if m.get("transform", 0) % 2 == 1:
            w, h = h, w
        result.append({
            "name": m["name"],
            "description": m.get("description", ""),
            "x": m["x"], "y": m["y"], "w": w, "h": h,
        })
    return result


def target_aspect(s, mons):
    chosen = [m for m in mons if m["name"] == s["output"]] or mons
    if not chosen:
        return None
    left = min(m["x"] for m in chosen)
    top = min(m["y"] for m in chosen)
    right = max(m["x"] + m["w"] for m in chosen)
    bottom = max(m["y"] + m["h"] for m in chosen)
    aspect = (right - left) / max(1, bottom - top)
    # A quarter-turn tablet is held portrait, so the surface meets the screen sideways.
    if s["rotation"] in (90, 270):
        aspect = 1 / aspect
    return aspect


def area(s, mons, size):
    full_w, full_h = size
    w, h = full_w, full_h
    aspect = target_aspect(s, mons) if s["matchAspect"] else None
    if aspect:
        if w / h > aspect:
            w = h * aspect
        else:
            h = w / aspect
    k = s["areaPercent"] / 100
    w, h = w * k, h * k
    x = (full_w - w) / 2
    y = (full_h - h) / 2
    return {"w": round(w, 1), "h": round(h, 1), "x": round(x, 1), "y": round(y, 1)}


def lua_bool(v):
    return "true" if v else "false"


def render(s, a, size, pen, finger):
    # Flipping uses libinput's left-handed mode on the pen only: libinput turns
    # the paired Wacom touch surface with it. Setting left-handed on the touch
    # device as well can latch the pen upside down (see unlatch()). Quarter
    # turns are done by tablet-buttons, which replays the pen as "<pen> Remap"
    # and the touch as "<finger> Rotated" with their axes already turned; the
    # transform on the real pen only matters while that service isn't running.
    transform = {0: 0, 90: 1, 180: 0, 270: 3}[s["rotation"]]
    quarter = s["rotation"] in (90, 270)
    flipped = s["rotation"] == 180
    full = a["w"] >= size[0] - 0.05 and a["h"] >= size[1] - 0.05

    def area_lines(turned):
        if full:
            return ""
        # The area is always centred, so turning it a quarter just swaps the axes.
        w, h, x, y = (a["h"], a["w"], a["y"], a["x"]) if turned else (a["w"], a["h"], a["x"], a["y"])
        return (f'    active_area_size = "{w} {h}",\n'
                f'    active_area_position = "{x} {y}",\n')

    pressure_max = round(1.0 - s["pressure"] / 100 * 0.6, 3)
    blocks = []
    if pen:
        # The real pen, then tablet-buttons' clone (pen buttons remapped or a quarter turn).
        for name, turn, turned in ((pen, transform, False), (pen + "-remap", 0, quarter)):
            blocks.append(f"""hl.device({{
    name = "{name}",
    output = "{s["output"]}",
    transform = {turn},
    left_handed = {lua_bool(flipped)},
{area_lines(turned)}}})
""")
        blocks.append(f"""hl.config({{
    input = {{
        tablettool = {{
            pressure_range_min = 0.0,
            pressure_range_max = {pressure_max},
        }},
    }},
}})
""")
    if finger:
        for name in (finger, finger + "-rotated"):
            blocks.append(f"""hl.device({{
    name = "{name}",
    enabled = {lua_bool(s["fingerEnabled"])},
    left_handed = false,
    sensitivity = {s["fingerSpeed"]},
    natural_scroll = {lua_bool(s["naturalScroll"])},
    tap_to_click = {lua_bool(s["tapToClick"])},
}})
""")
    return "\n".join(blocks)


def remember(s, desc):
    """Keep the tablet's names and size so tablet.lua can be written while it's unplugged."""
    if desc:
        s["lastDevice"] = {"pen": desc["penName"], "finger": desc["fingerName"],
                           "sizeMm": desc["sizeMm"] or s["lastDevice"].get("sizeMm") or FALLBACK_MM,
                           "model": desc["modelName"]}
    return s


def unlatch(finger):
    """Clear libinput's pen/touch rotation latch.

    libinput keeps the pen rotated while it believes the paired touch surface
    is left-handed, and the touch side reports "me or the pen" rather than its
    own state. 0.2.0 set left-handed on the touch device too, and Hyprland
    turns that off before the pen's, which left the pen upside down in Normal.
    Toggling left-handed on the touch device alone makes it report its real
    state. It must run after the pen's own left-handed change has landed,
    which libinput defers until the pen leaves proximity, so wait for that."""
    tablet = tabletlib.detect()
    pen = tablet and tablet.get("pen")
    if pen:
        deadline = time.time() + 120
        out_since = None
        while time.time() < deadline:
            if tabletlib.pen_in_proximity(pen["path"]):
                out_since = None
            elif out_since is None:
                out_since = time.time()
            elif time.time() - out_since > 0.5:
                break
            time.sleep(0.1)
    for value in ("true", "false"):
        subprocess.run(["hyprctl", "eval", f'hl.device({{ name = "{finger}", left_handed = {value} }})'],
                       capture_output=True, timeout=5)


def spawn_unlatch():
    subprocess.Popen([os.path.realpath(__file__), "unlatch"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(s):
    """Send the settings to Hyprland. Returns Hyprland's error, or ""."""
    dev = s["lastDevice"]
    size = dev.get("sizeMm") or FALLBACK_MM
    lua = render(s, area(s, monitors(), size), size, dev.get("pen"), dev.get("finger"))
    if not lua:
        return ""  # no tablet seen yet
    out = subprocess.run(["hyprctl", "eval", lua], capture_output=True, text=True, timeout=10)
    return "" if out.returncode == 0 else (out.stdout + out.stderr).strip()


# Settings only tablet-buttons reads. Changing them leaves the Hyprland settings as they are,
# so there is nothing to send; sending them again would also drop an area lock for a moment.
SERVICE_ONLY = {"areaLock", "areaActivate", "ignoreTaps", "tapIgnoredApps", "apps", "ignoredApps"}


def write(s, send=True):
    try:
        with open(STATE) as f:
            previous_rotation = json.load(f).get("rotation", 0)
    except (OSError, ValueError, AttributeError):
        previous_rotation = None
    tablet, desc = current_tablet(s)
    s = remember(s, desc)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=2)
    os.replace(tmp, STATE)
    error = apply(s) if send else ""
    if s["lastDevice"].get("finger") and previous_rotation != s["rotation"] and s["rotation"] != 180:
        spawn_unlatch()
    return error


def retire_legacy_config():
    """Undo 0.1-0.3's setup: drop the require line from hyprland.lua (a copy is
    kept as hyprland.lua.wacom-bamboo.bak) and move tablet.lua aside. Returns
    True when hyprland.lua changed."""
    try:
        with open(HYPRLAND) as f:
            text = f.read()
    except OSError:
        text = ""
    lines = text.splitlines(keepends=True)
    kept = [line for line in lines if line.strip() not in (LEGACY_REQUIRE, "-- Wacom tablet settings (Wacom Bamboo bar widget)")]
    changed = len(kept) != len(lines)
    if changed:
        with open(HYPRLAND + ".wacom-bamboo.bak", "w") as f:
            f.write(text)
        tmp = HYPRLAND + ".tmp"
        with open(tmp, "w") as f:
            f.write("".join(kept))
        os.replace(tmp, HYPRLAND)
    if os.path.exists(LEGACY_LUA):
        os.replace(LEGACY_LUA, LEGACY_LUA + ".bak")
    return changed


def daemon_running():
    try:
        fd = os.open(DAEMON_LOCK, os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


# Stock Omarchy keeps /dev/input/event* to the input group and /dev/uinput to
# root. Tagging the Wacom devices and uinput "uaccess" lets the user at the
# seat use them, from the moment the rule is triggered (no group, no re-login).
UDEV_RULE = "/etc/udev/rules.d/70-omarchy-wacom-bamboo.rules"
UDEV_RULE_TEXT = """\
# Omarchy Wacom Bamboo plugin: lets the logged-in user remap tablet buttons
# and turn the tablet (tablet-buttons grabs the tablet and creates virtual
# devices through uinput). Delete this file to undo.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
""" + "".join(f'SUBSYSTEM=="input", KERNEL=="event*", ATTRS{{id/vendor}}=="{v}", TAG+="uaccess"\n'
              for v in sorted(tabletlib.WACOM_VENDORS))


def input_access(tablet):
    """False when tablet-buttons can't do its job: the tablet's event devices
    can't be read or /dev/uinput can't be written."""
    paths = [d["path"] for d in (tablet.get("pen"), tablet.get("pad"), tablet.get("finger")) if d] if tablet else []
    return all(os.access(p, os.R_OK) for p in paths) and os.access("/dev/uinput", os.W_OK)


def enable_access():
    """Install UDEV_RULE through pkexec and apply it to the devices already plugged in."""
    script = (f"cat > {UDEV_RULE} <<'EOF'\n{UDEV_RULE_TEXT}EOF\n"
              "udevadm control --reload\n"
              "udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput\n"
              "udevadm trigger --action=change --subsystem-match=input\n"
              "udevadm settle --timeout=5\n")
    out = subprocess.run(["pkexec", "/bin/sh", "-c", script], capture_output=True, text=True)
    if out.returncode in (126, 127):
        return "Not enabled: the password prompt was dismissed."
    return "" if out.returncode == 0 else (out.stderr.strip() or f"pkexec exited with {out.returncode}")


def status(s, error=""):
    mons = monitors()
    tablet, desc = current_tablet(s)
    size = (desc and desc["sizeMm"]) or s["lastDevice"].get("sizeMm") or FALLBACK_MM
    devices = hypr_json("devices") or {}
    tablet_names = {t.get("name") for t in devices.get("tablets", [])}
    if desc:
        default_desc = desc if s["rotation"] == 0 else tabletlib.describe(
            tablet, 0, s["slotCodes"].get(f'{desc["vendor"]}:{desc["product"]}'))
        s = dict(s, buttons=tabletlib.resolve_buttons(s["buttons"], default_desc))
    return {
        "settings": s,
        "tablet": desc,
        "pen": bool(desc and desc["hasPen"]) and (desc["penName"] in tablet_names or desc["penName"] + "-remap" in tablet_names),
        "finger": bool(desc and desc["hasTouch"]),
        "buttonsService": daemon_running(),
        "inputAccess": input_access(tablet),
        "wacomDriver": os.path.isdir("/sys/module/wacom"),
        "monitors": [{"name": m["name"], "description": m["description"]} for m in mons],
        "area": area(s, mons, size),
        "tabletMm": {"w": size[0], "h": size[1]},
        "error": error,
    }


def apps_report(s):
    """What the Applications tab shows: scanned drawing apps and open windows.

    Both lists are marked with what the user already decided, so the panel can hide the apps
    that are listed or dismissed without asking again."""
    listed = {c.lower() for c in s["apps"]}
    ignored = {c.lower() for c in s["ignoredApps"]}
    candidates = [dict(a, listed=a["class"].lower() in listed, ignored=a["class"].lower() in ignored)
                  for a in tabletarea.installed_apps()]
    seen = set()
    windows = []
    for c in hypr_json("clients") or []:
        cls = c.get("class") or ""
        if cls and cls.lower() not in seen:
            seen.add(cls.lower())
            windows.append({"class": cls, "title": c.get("title", ""), "listed": cls.lower() in listed})
    return {"candidates": candidates, "windows": windows}


def merge(s, patch):
    out = dict(s)
    for key, value in patch.items():
        if key == "buttons":
            merged = {k: dict(v) for k, v in s.get("buttons", {}).items()}
            for bkey, spec in value.items():
                merged[bkey] = {**merged.get(bkey, {}), **spec}
            out["buttons"] = merged
        elif key == "slotCodes":
            # The panel sends the learnt order for the connected tablet only.
            tablet = tabletlib.detect()
            if tablet:
                out["slotCodes"] = {**s.get("slotCodes", {}), f'{tablet["vendor"]}:{tablet["product"]}': value}
        else:
            out[key] = value
    return out


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    s = load()
    error = ""
    if cmd == "set":
        patch = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
        s = sanitize(merge(s, patch))
        error = write(s, send=not set(patch) <= SERVICE_ONLY)
        s = load()
    elif cmd == "toggle":
        key = sys.argv[2] if len(sys.argv) > 2 else ""
        if not isinstance(DEFAULTS.get(key), bool):
            print(f"tablet-ctl: {key!r} is not an on/off setting", file=sys.stderr)
            sys.exit(2)
        s = sanitize(merge(s, {key: not s[key]}))
        error = write(s)
        s = load()
        if error:
            print(error, file=sys.stderr)
        elif key == "fingerEnabled":
            subprocess.run(["notify-send", "-t", "1500", "Tablet",
                            "Finger touch " + ("on" if s[key] else "off")])
        return
    elif cmd == "reset":
        keep = {"slotCodes": s["slotCodes"], "lastDevice": s["lastDevice"]}
        s = sanitize({**DEFAULTS, **keep})
        error = write(s)
    elif cmd == "enable-access":
        error = enable_access()
    elif cmd == "apply":
        tablet, desc = current_tablet(s)
        if desc and remember(dict(s), desc)["lastDevice"] != s["lastDevice"]:
            write(remember(s, desc))  # first time this tablet is seen: save its names, then apply
        if retire_legacy_config():
            # The reload drops the old settings; tablet-buttons applies again after it.
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        error = apply(s)
        if error:
            print(error, file=sys.stderr)
            sys.exit(1)
        return
    elif cmd == "unlatch":
        finger = s["lastDevice"].get("finger")
        if finger and s["rotation"] != 180:
            unlatch(finger)
        return
    elif cmd == "apps":
        print(json.dumps(apps_report(s)))
        return
    elif cmd != "status":
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    print(json.dumps(status(s, error)))


if __name__ == "__main__":
    main()
