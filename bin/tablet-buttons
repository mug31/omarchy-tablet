#!/usr/bin/python3
"""Button remapper for Wacom tablets on the kernel wacom driver.

Started by the bar panel (one per monitor bar, so the copies take turns:
the first holds a lock and the rest wait on it, ready to take over). Reads
~/.config/omarchy/tablet.json and re-reads it whenever the file changes.
Logs to ~/.cache/omarchy-tablet/tablet-buttons.log.

Settings: the panel sends them to Hyprland with `hyprctl eval`, which only
lasts until Hyprland reloads its config. This daemon runs `tablet-ctl apply`
when it starts, when the tablet appears and after every config reload or
monitor change (the active area follows the monitor's shape).

Pad: left alone while every ExpressKey is on "default", so apps such as
Krita see them as usual. Otherwise the pad is grabbed and its keys turned into
clicks, shortcuts or commands; keys still on "default" are replayed through a
virtual clone with the same name, which libinput again treats as a tablet pad.
Keys are named by the evdev code they send (BTN_RIGHT, BTN_0, ...).

Pen: left alone while every side button is on "default" and the tablet is
not turned a quarter. Otherwise the real pen is grabbed and replayed through a
virtual clone ("<pen> Remap") so pressure and tilt keep working, with the
remapped buttons swallowed and turned into their action instead.

Quarter turns (90/270): Hyprland's tablet transform is a libinput calibration
matrix, which libinput ignores on tablets without a screen, and libinput can't
rotate the Wacom touch surface at all. So at 90/270 the daemon turns the axes
itself: the pen clone and a "<finger> Rotated" clone send rotated coordinates.
The two clones share a phys, so libinput groups them like the real pair and
its pen/touch arbitration keeps working. Flipped (180) needs none of this:
libinput's left-handed mode turns both pen and touch.

Every press is also written to ~/.cache/omarchy-tablet/last-button so the
bar panel can light up the button that was pressed.
"""
import asyncio
import ctypes
import fcntl
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import tabletlib  # noqa: E402
from evio import Device, UInput, ecodes as e  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/omarchy/tablet.json")
CACHE = os.path.join(HOME, ".cache/omarchy-tablet")
LAST = os.path.join(CACHE, "last-button")
LOCK = os.path.join(CACHE, "tablet-buttons.lock")
LOG = os.path.join(CACHE, "tablet-buttons.log")
# Where 0.1-0.3 ran this as a systemd user service.
SERVICE = os.path.join(HOME, ".config/systemd/user/tablet-buttons.service")
TABLET_CTL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "tablet-ctl")
# Present while the panel's "Identify keys" runs: presses are reported, not acted on.
IDENTIFY = os.path.join(HOME, ".cache/omarchy-tablet/identify")

# Every clone gets this phys, so libinput puts the pen and touch clones in one
# device group and pairs them like the real tablet.
PHYS = "omarchy-tablet/input0"

LEGACY_PAD = {"pad1": "BTN_LEFT", "pad2": "BTN_FORWARD", "pad3": "BTN_BACK", "pad4": "BTN_RIGHT"}

CLICKS = {"left": e.BTN_LEFT, "right": e.BTN_RIGHT, "middle": e.BTN_MIDDLE}
MODIFIERS = {
    "ctrl": e.KEY_LEFTCTRL, "control": e.KEY_LEFTCTRL,
    "shift": e.KEY_LEFTSHIFT,
    "alt": e.KEY_LEFTALT,
    "super": e.KEY_LEFTMETA, "meta": e.KEY_LEFTMETA, "win": e.KEY_LEFTMETA,
}
KEY_ALIASES = {
    "esc": "ESC", "escape": "ESC", "return": "ENTER", "del": "DELETE",
    "pgup": "PAGEUP", "pgdn": "PAGEDOWN", "[": "LEFTBRACE", "]": "RIGHTBRACE",
    "-": "MINUS", "=": "EQUAL", "+": "EQUAL", ",": "COMMA", ".": "DOT",
    "/": "SLASH", ";": "SEMICOLON", "'": "APOSTROPHE", "`": "GRAVE",
    "\\": "BACKSLASH", "plus": "EQUAL", "minus": "MINUS",
}


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def parse_combo(text):
    """'ctrl+shift+z' -> [KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_Z], or None."""
    parts = [p.strip().lower() for p in str(text).replace(" ", "").split("+")]
    # "ctrl++" means ctrl and the plus key.
    if str(text).endswith("++"):
        parts = parts[:-2] + ["+"]
    codes = []
    for part in parts:
        if not part:
            return None
        if part in MODIFIERS:
            codes.append(MODIFIERS[part])
            continue
        name = KEY_ALIASES.get(part, part.upper())
        code = getattr(e, "KEY_" + name, None)
        if code is None:
            return None
        codes.append(code)
    return codes or None


def load_state():
    try:
        with open(STATE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}, {}, 0
    buttons = {LEGACY_PAD.get(k, k): v for k, v in (data.get("buttons") or {}).items() if isinstance(v, dict)}
    try:
        rotation = int(data.get("rotation", 0)) % 360 // 90 * 90
    except (TypeError, ValueError):
        rotation = 0
    return buttons, data.get("slotCodes") or {}, rotation


def identifying():
    try:
        return time.time() - os.stat(IDENTIFY).st_mtime < 120
    except OSError:
        return False


def mark(button, down):
    if not down:
        return
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST, "w") as f:
            f.write(f"{button} {time.time():.3f}\n")
    except OSError:
        pass


class Outputs:
    """Virtual keyboard and mouse the actions are typed and clicked through."""

    def __init__(self):
        keys = list(range(e.KEY_ESC, e.KEY_MICMUTE + 1))
        self.kbd = UInput({e.EV_KEY: keys}, name="Tablet Buttons Keyboard")
        self.mouse = UInput(
            {e.EV_KEY: list(CLICKS.values()), e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]},
            name="Tablet Buttons Mouse",
        )
        self.held = {}

    def press(self, button, spec, down):
        action = spec.get("action", "none")
        value = spec.get("value", "")
        if action in CLICKS:
            self.mouse.write(e.EV_KEY, CLICKS[action], 1 if down else 0)
            self.mouse.syn()
        elif action == "key":
            if down:
                codes = parse_combo(value)
                if not codes:
                    log(f"{button}: cannot parse shortcut {value!r}")
                    return
                self.held[button] = codes
                for code in codes:
                    self.kbd.write(e.EV_KEY, code, 1)
                self.kbd.syn()
            else:
                for code in reversed(self.held.pop(button, [])):
                    self.kbd.write(e.EV_KEY, code, 0)
                self.kbd.syn()
        elif action == "command" and down and value.strip():
            subprocess.Popen(["sh", "-c", value], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def release_all(self):
        for button in list(self.held):
            self.press(button, {"action": "key"}, False)
        for code in CLICKS.values():
            self.mouse.write(e.EV_KEY, code, 0)
        self.mouse.syn()


async def events(dev):
    """Events from `dev`, read as the event loop sees its fd become readable."""
    loop = asyncio.get_running_loop()
    queue = asyncio.Queue()

    def ready():
        try:
            for ev in dev.read():
                queue.put_nowait(ev)
        except BlockingIOError:
            pass
        except OSError as exc:  # unplugged
            loop.remove_reader(dev.fd)
            queue.put_nowait(exc)

    loop.add_reader(dev.fd, ready)
    try:
        while True:
            ev = await queue.get()
            if isinstance(ev, Exception):
                raise ev
            yield ev
    finally:
        try:
            loop.remove_reader(dev.fd)
        except (ValueError, OSError):
            pass


def open_device(path):
    try:
        return Device(path) if path else None
    except OSError:
        return None


# Axis pairs turned together at 90/270.
AXIS_PAIRS = [(e.ABS_X, e.ABS_Y), (e.ABS_TILT_X, e.ABS_TILT_Y),
              (e.ABS_MT_POSITION_X, e.ABS_MT_POSITION_Y)]
# Palm rejection fallback for the rotated touch: cut it while the pen hovers
# and this long after it leaves.
PEN_HOLD = 0.5
pen_near = False
pen_left = 0.0


def turn(absinfo, rotation):
    """{old code: (new code, value fn)} and the clone's absinfo for a quarter turn."""
    remap, info = {}, dict(absinfo)
    if rotation not in (90, 270):
        return remap, info
    same = lambda v: v  # noqa: E731
    for x, y in AXIS_PAIRS:
        if x not in absinfo or y not in absinfo:
            continue
        ax, ay = absinfo[x], absinfo[y]
        if rotation == 90:  # x' = flipped y, y' = x
            remap[y], remap[x] = (x, lambda v, a=ay: a.max + a.min - v), (y, same)
        else:               # x' = y, y' = flipped x
            remap[y], remap[x] = (x, same), (y, lambda v, a=ax: a.max + a.min - v)
        info[x], info[y] = ay, ax
    return remap, info


def clone_of(dev, name, rotation=0):
    """Virtual copy of `dev`, its axes turned by `rotation`. Returns (clone, remap)."""
    remap, info = turn(dev.absinfo, rotation)
    clone = UInput(dev.caps, name, absinfo=info, vendor=dev.vendor, product=dev.product,
                   version=dev.version, bustype=dev.bustype, props=dev.props, phys=PHYS)
    return clone, remap


def replay(clone, remap, ev):
    if ev.type == e.EV_ABS and ev.code in remap:
        code, fn = remap[ev.code]
        clone.write(e.EV_ABS, code, fn(ev.value))
    else:
        clone.write_event(ev)


def track_pen(ev):
    global pen_near, pen_left
    if ev.type == e.EV_KEY and ev.code in (e.BTN_TOOL_PEN, e.BTN_TOOL_RUBBER):
        pen_near = ev.value == 1
        if not pen_near:
            pen_left = time.monotonic()


async def run_pad(dev, buttons, out):
    def action(name):
        return buttons.get(name, {"action": "none"}).get("action", "none")

    keys = [tabletlib.KEY_NAMES.get(c, f"KEY_{c}")
            for c in dev.caps.get(e.EV_KEY, []) if not 0x140 <= c <= 0x14F]
    if all(action(k) == "default" for k in keys):
        # Nothing remapped: leave the pad to the apps, only report presses for the panel.
        try:
            async for ev in events(dev):
                if ev.type == e.EV_KEY and ev.value in (0, 1) and not 0x140 <= ev.code <= 0x14F:
                    mark(tabletlib.KEY_NAMES.get(ev.code, f"KEY_{ev.code}"), ev.value == 1)
        finally:
            dev.close()
        return

    # The clone keeps the pad's exact name: udev only tags a device as a tablet
    # pad (ID_INPUT_TABLET_PAD) by name, and without that apps never see it.
    clone = clone_of(dev, dev.name)[0] if any(action(k) == "default" for k in keys) else None
    dev.grab()
    try:
        async for ev in events(dev):
            if ev.type == e.EV_KEY and not 0x140 <= ev.code <= 0x14F:
                name = tabletlib.KEY_NAMES.get(ev.code, f"KEY_{ev.code}")
                if ev.value in (0, 1):
                    mark(name, ev.value == 1)
                if ev.value == 1 and identifying():
                    continue
                if action(name) != "default":
                    if ev.value in (0, 1):
                        out.press(name, buttons.get(name, {"action": "none"}), ev.value == 1)
                    continue
            if clone:
                clone.write_event(ev)
    finally:
        try:
            dev.ungrab()
        except OSError:
            pass
        if clone:
            clone.close()
        dev.close()


async def run_pen(dev, buttons, out, rotation):
    names = tabletlib.PEN_BUTTONS
    remapped = {code for code, name in names.items()
                if buttons.get(name, {}).get("action", "default") != "default"}
    if not remapped and rotation not in (90, 270):
        # Nothing to change: leave the real pen alone, only report presses for the panel.
        try:
            async for ev in events(dev):
                track_pen(ev)
                if ev.type == e.EV_KEY and ev.code in names:
                    mark(names[ev.code], ev.value == 1)
        finally:
            dev.close()
        return

    clone, remap = clone_of(dev, dev.name + tabletlib.REMAP_SUFFIX, rotation)
    dev.grab()
    try:
        async for ev in events(dev):
            track_pen(ev)
            if ev.type == e.EV_KEY and ev.code in names:
                name = names[ev.code]
                mark(name, ev.value == 1)
                if ev.code in remapped:
                    if ev.value in (0, 1):
                        out.press(name, buttons[name], ev.value == 1)
                    continue
            replay(clone, remap, ev)
    finally:
        try:
            dev.ungrab()
        except OSError:
            pass
        clone.close()
        dev.close()


async def run_finger(dev, rotation):
    """Replay the touch surface turned a quarter, as "<finger> Rotated"."""
    clone, remap = clone_of(dev, dev.name + tabletlib.ROTATED_SUFFIX, rotation)
    dev.grab()
    slots = {}       # slot -> tracking id, as the clone last saw it
    slot = 0
    touching = False
    blocked = False

    def lift_all():
        for s, tid in list(slots.items()):
            if tid != -1:
                clone.write(e.EV_ABS, e.ABS_MT_SLOT, s)
                clone.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
        slots.clear()
        for k in (e.BTN_TOUCH, e.BTN_TOOL_FINGER, e.BTN_TOOL_DOUBLETAP):
            clone.write(e.EV_KEY, k, 0)
        clone.syn()

    try:
        async for ev in events(dev):
            if ev.type == e.EV_KEY and ev.code == e.BTN_TOUCH:
                touching = ev.value == 1
            if ev.type == e.EV_ABS and ev.code == e.ABS_MT_SLOT:
                slot = ev.value
            if pen_near or time.monotonic() - pen_left < PEN_HOLD:
                if not blocked:
                    blocked = True
                    lift_all()
                continue
            if blocked:
                # A palm still resting once the pen left stays ignored until every finger lifts.
                if ev.type == e.EV_SYN and not touching:
                    blocked = False
                    clone.write(e.EV_ABS, e.ABS_MT_SLOT, slot)  # lift_all moved the clone's slot
                continue
            if ev.type == e.EV_ABS and ev.code == e.ABS_MT_TRACKING_ID:
                slots[slot] = ev.value
            replay(clone, remap, ev)
    finally:
        try:
            dev.ungrab()
        except OSError:
            pass
        clone.close()
        dev.close()


def state_mtime():
    try:
        return os.stat(STATE).st_mtime
    except OSError:
        return 0


async def apply_settings(reason):
    proc = await asyncio.create_subprocess_exec(TABLET_CTL, "apply", stdout=asyncio.subprocess.DEVNULL,
                                                stderr=asyncio.subprocess.PIPE)
    _, err = await proc.communicate()
    if proc.returncode:
        log(f"apply ({reason}) failed:", err.decode(errors="replace").strip())
    else:
        log(f"settings applied ({reason})")


async def watch_hyprland():
    """Re-apply the settings after each Hyprland config reload or monitor change."""
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "hypr",
                        os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket2.sock")
    while True:
        try:
            reader, writer = await asyncio.open_unix_connection(sock)
        except OSError as exc:
            log("hyprland events:", exc)
            await asyncio.sleep(5)
            continue
        try:
            while line := await reader.readline():
                if line.startswith((b"configreloaded>>", b"monitoradded", b"monitorremoved")):
                    await asyncio.sleep(0.3)  # a reload often comes with monitor events: settle first
                    await apply_settings(line.split(b">>")[0].decode())
        finally:
            writer.close()
        await asyncio.sleep(1)


async def main():
    try:
        out = Outputs()
    except OSError as exc:
        # No access to /dev/uinput: settings still get applied, remapping can't work.
        log("cannot create virtual devices:", exc)
        out = None
    watcher = asyncio.create_task(watch_hyprland())  # noqa: F841  (kept alive for good)
    tasks = []
    signature = None
    while True:
        tablet = tabletlib.detect()
        pen_path = tablet["pen"]["path"] if tablet and tablet.get("pen") else None
        pad_path = tablet["pad"]["path"] if tablet and tablet.get("pad") else None
        finger_path = tablet["finger"]["path"] if tablet and tablet.get("finger") else None
        current = (state_mtime(), pen_path, pad_path, finger_path)
        alive = all(not t.done() for t in tasks)
        for t in tasks:
            if t.done() and not t.cancelled() and t.exception() and not isinstance(t.exception(), OSError):
                log("task failed:", repr(t.exception()))
        if current != signature or not alive:
            for t in tasks:
                t.cancel()
            await asyncio.gather(*tasks, return_exceptions=True)
            if out:
                out.release_all()
            tasks = []
            saved, slot_codes, rotation = load_state()
            buttons = {}
            if tablet:
                key = f'{tablet["vendor"]}:{tablet["product"]}'
                buttons = tabletlib.resolve_buttons(saved, tabletlib.describe(tablet, 0, slot_codes.get(key)))
            if current[1:] != (signature or (None,) * 4)[1:]:
                await apply_settings("tablet seen")  # plugged in, or first run
            pad, pen = (open_device(pad_path), open_device(pen_path)) if out else (None, None)
            finger = open_device(finger_path) if out and rotation in (90, 270) else None
            if pad:
                tasks.append(asyncio.create_task(run_pad(pad, buttons, out)))
            if pen:
                tasks.append(asyncio.create_task(run_pen(pen, buttons, out, rotation)))
            if finger:
                tasks.append(asyncio.create_task(run_finger(finger, rotation)))
            log("tablet:", tablet["kernelName"] if tablet else "-",
                "| pen" if pen else "| -", "pad" if pad else "-", f"| rotation {rotation}",
                "| pen remap:", [k for k in ("pen1", "pen2", "pen3")
                                 if buttons.get(k, {}).get("action", "default") != "default"])
            signature = current
        await asyncio.sleep(1)


def retire_service():
    """0.3 and earlier ran this as a systemd user service; the panel runs it now."""
    if not os.path.exists(SERVICE):
        return
    subprocess.run(["systemctl", "--user", "disable", "--now", "tablet-buttons.service"], capture_output=True)
    try:
        os.replace(SERVICE, SERVICE + ".bak")
    except OSError:
        pass  # another bar's copy got there first
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)


def take_lock():
    """Block until no other copy runs, then hold the lock for good."""
    os.makedirs(CACHE, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


if __name__ == "__main__":
    # The panel passes --panel. (INVOCATION_ID can't tell: the shell itself
    # runs inside a systemd unit and passes it on.)
    panel = "--panel" in sys.argv
    if panel:
        # Quit with the shell instead of lingering on with the lock.
        ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
        retire_service()
    lock = take_lock()
    if panel:
        sys.stderr = open(LOG, "w", buffering=1)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
